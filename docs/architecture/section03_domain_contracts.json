{
  "version": 1,
  "contexts": {
    "entrypoints": {
      "purpose": "Compose adapters and operator commands",
      "aggregates": "Application composition; not a business aggregate",
      "value_objects": "Settings and validated CLI options",
      "repositories": "No independent repository ownership",
      "services": "create_app; bootstrap; provisioning; event/release/local CLIs",
      "invariants": "No implied authority or destructive auto-reset",
      "published_language": "Operator commands and health response contracts",
      "consistency": "Explicit operator transactions; no global transaction"
    },
    "transport": {
      "purpose": "Validate and expose context operations",
      "aggregates": "Request/response DTOs; no aggregate ownership",
      "value_objects": "Pydantic inputs and server-derived Principal",
      "repositories": "Use reviewed stores; never introduce unregistered SQL access",
      "services": "api_* and console_* route adapters",
      "invariants": "Authentication, tenant derivation, permission checks, bounded inputs",
      "published_language": "Versioned /v1 REST OpenAPI; status/error semantics",
      "consistency": "Each request commits owned operation; no implicit cross-request unit of work"
    },
    "governance": {
      "purpose": "Identity, human authorization, council and independent QA",
      "aggregates": "User/session/RBAC; ApprovalRequest; council proposal; Review",
      "value_objects": "Principal; Risk; Decision; Verdict; scoped identity",
      "repositories": "identity; login_security; governance; council_store; quality_store; security_controls",
      "services": "GovernanceGate; approval/QA decision coordination",
      "invariants": "Independent approver, tenant scope, active human, append-only audit, no caller authority flag",
      "published_language": "Approval IDs/status; decision reasons; QA verdict/evidence; signed sessions",
      "consistency": "Approval/review plus audit atomic in database transaction; recheck before execution"
    },
    "strategy": {
      "purpose": "Company Brain, advisory Meta Brain and governed policy versions",
      "aggregates": "Goal and plan/step records; DNA version; experiment proposal; executive snapshot",
      "value_objects": "Plan dependency IDs; immutable digest; validated threshold profile",
      "repositories": "goals; plan_store; organizational_dna; meta_brain; executive_intelligence; experiments",
      "services": "PlanExecution; MetaBrain; ScenarioSimulator",
      "invariants": "Tenant references, acyclic prerequisites, independent activation, no autonomous policy mutation",
      "published_language": "Goal/plan IDs and status; approval reference; scenario_only; advisory evidence",
      "consistency": "Plan activation/materialization transactions; per-task approval remains separate"
    },
    "workforce": {
      "purpose": "Organization, task ownership and bounded execution",
      "aggregates": "Department; Employee; governed Task; agent Run",
      "value_objects": "Employee kind; manager_id; task action/state",
      "repositories": "organization_store; task_store; agent_runtime",
      "services": "AgentRuntime; execution handlers; model_handlers",
      "invariants": "Same-department manager, active assignee, per-task authorization, single-use run, allowlist",
      "published_language": "Tenant/task/employee IDs; task/run states; evidence result",
      "consistency": "Claim transaction then bounded handler then result transaction; crash is not automatic replay"
    },
    "knowledge": {
      "purpose": "Private organizational memory and reviewed facts",
      "aggregates": "MemoryRecord; proposed knowledge node and edge",
      "value_objects": "Visibility scope; provenance reference; relation/verdict type",
      "repositories": "MemoryStore in organization_store; knowledge_store; DatabaseStore graph/vector/document metadata",
      "services": "MemoryRecord privacy checks; KnowledgeStore review/relate; bounded traversal, offline semantic retrieval and private objects",
      "invariants": "Tenant/private access, independent fact verification, provenance; no fabricated RAG",
      "published_language": "Memory records; node/edge IDs; evidence references",
      "consistency": "Record/review transactions; graph-memory consolidation is not currently automatic"
    },
    "operations": {
      "purpose": "Internal collaboration, reviewed tools and departmental triggers",
      "aggregates": "Handoff; calendar event/attendee; tool enrollment; trigger run",
      "value_objects": "Invitation response; bounded tool code; source provenance",
      "repositories": "handoffs; calendar_store; tool_enrollment; tool_runtime; department_automation",
      "services": "Read-only tool catalog; ToolRuntime; trigger reconciliation",
      "invariants": "Same-tenant references, approved enrollment, one-use task execution, invitee-only RSVP",
      "published_language": "Handoff states; event/attendee IDs; reviewed read-only tool/evidence contract",
      "consistency": "Owned transactions; external opt-in work cannot share PostgreSQL atomic commit"
    },
    "economics": {
      "purpose": "Internal quota and operational measurements",
      "aggregates": "Budget; usage ledger; scorecard read model",
      "value_objects": "Decimal credits; idempotency key; bounded cost/failure inputs",
      "repositories": "credits; scorecard",
      "services": "Scorecard; virtual quota reconciliation",
      "invariants": "Finite nonnegative credits, tenant scope, unique consumption; no monetary settlement claim",
      "published_language": "Credit ledger and risk/scorecard records; not currency",
      "consistency": "Quota and ledger consistency in owned transactions; scorecards are snapshots"
    },
    "platform": {
      "purpose": "Shared technical infrastructure without business authority",
      "aggregates": "Event; inbox/outbox entry; plugin registration; scheduled job",
      "value_objects": "Event ID/name/time/correlation; version; lease identity",
      "repositories": "event_store; postgres_event_store; migration checksum metadata; MessageStore versioned ordered inbox/outbox",
      "services": "EventBus; EventWorker; IntervalScheduler; readiness; DI; release perimeter",
      "invariants": "Idempotence, owned leases, checksum migrations, fail-closed readiness, no permission bypass",
      "published_language": "Event envelope and EventRegistry validation; health; config; dispatch report",
      "consistency": "At least once durable delivery; explicit producer/outbox transaction; process-local bus is not durable"
    }
  },
