# TEMPLATE ONLY — never commit a filled copy or deploy this file verbatim.
# Provision secrets via secret manager; DO NOT place live passwords in repo.
AGO_ENVIRONMENT=production
AGO_ALLOWED_HOSTS=ago.example.com
AGO_SESSION_SECRET=REPLACE_WITH_UNIQUE_CRYPTOGRAPHICALLY_RANDOM_48_PLUS_CHAR_SECRET
AGO_POSTGRES_DSN=postgresql://privileged_app_user:REPLACE_FROM_SECRET_MANAGER@db.example.com:5432/ago_prod?sslmode=verify-full&sslrootcert=/etc/ago/db-root-ca.pem
AGO_MIGRATIONS_DIR=/app/deploy/sql
AGO_ENABLE_PAID_MODELS=false
AGO_M8_EXTERNAL_ENABLED=false
AGO_MAX_REQUEST_BYTES=1048576
AGO_LOG_LEVEL=INFO
# Real production requires reviewed TLS proxy, rate limits and restricted egress.
# AGO HTTPS business endpoints will return 426 if proxy headers are not trusted.
