# TEMPLATE ONLY — never commit a filled copy or deploy this file verbatim.
# Provision secrets via secret manager; DO NOT place live passwords in repo.
AGO_ENVIRONMENT=production
AGO_ALLOWED_HOSTS=ago.example.com
# Startup retrieves AGO_SESSION_SECRET, AGO_SESSION_KEYRING, AGO_POSTGRES_DSN,
# AGO_MFA_KEYS and optional AGO_OIDC_CLIENT_SECRET from this external KV-v2 bundle.
# These are non-secret references; provision actual reviewed values separately.
AGO_VAULT_URL=https://vault.example.com
AGO_VAULT_KV_PATH=secret/data/ago/production
AGO_VAULT_TOKEN_FILE=/run/secrets/ago-vault-token
AGO_VAULT_CA_FILE=/run/secrets/ago-vault-ca.pem
AGO_IDENTITY_POLICY=mfa
# For policy=oidc, supply approved non-secret AGO_OIDC_CONFIG JSON with issuer,
# client_id, authorization_endpoint, token_endpoint, exact redirect_uri and jwks_file.
AGO_MIGRATIONS_DIR=/app/deploy/sql
AGO_ENABLE_PAID_MODELS=false
AGO_M8_EXTERNAL_ENABLED=false
AGO_MAX_REQUEST_BYTES=1048576
AGO_LOG_LEVEL=INFO
# Real production requires reviewed TLS proxy, rate limits and restricted egress.
# AGO HTTPS business endpoints will return 426 if proxy headers are not trusted.
